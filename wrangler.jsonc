{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lauraribeiropsi",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
